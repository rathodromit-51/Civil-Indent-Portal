# Copy to .env next to docker-compose.yml:  cp .env.example .env

# Used for container names (<PROJECT_NAME>_app, ...) and the compose project/network/volume prefix
PROJECT_NAME=myproject
COMPOSE_PROJECT_NAME=myproject

# PHP version of the app images. 8.2 fits Laravel 10/11; use 8.4 for Laravel 12+.
# For prod also change the default in Dockerfile (ARG PHP_VERSION) so CI builds the same version.
PHP_VERSION=8.2

# --- Host ports (change when they clash with other projects on the same machine) ---
APP_PORT=80
MYSQL_PORT=3306
PMA_PORT=8081
SOKETI_PORT=6001

# --- Database ---
DB_DATABASE=app
DB_PASSWORD=root_password

# --- Soketi (profile: realtime) ---
PUSHER_APP_ID=app
PUSHER_APP_KEY=app-key
PUSHER_APP_SECRET=app-secret

# --- Cloudflare Tunnel (profile: tunnel) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Production only (docker-compose.prod.yml) ---
# Image built by CI, e.g. ghcr.io/<org>/<repo>/app:main
APP_IMAGE=
# Watchtower credentials for a private registry (GitHub PAT with read:packages). Never commit real values.
REGISTRY_USER=
REGISTRY_TOKEN=
